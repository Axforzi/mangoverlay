@@ -26,7 +26,24 @@
 using namespace lsfgvk;
 using namespace lsfgvk::layer;
 
-layer::Layer::Layer() : m_configuration(utils::getOrDefault()) {
+namespace {
+    /// Load the configuration without crashing the game: a corrupt config
+    /// (bad type, out-of-range value, unknown key, ...) used to throw out of
+    /// the constructor and escape the Vulkan C ABI. On any load failure we
+    /// log the error and fall back to an empty configuration, which makes
+    /// identifyProcess() return nullopt and unloads the layer (no FG, no HUD).
+    utils::Configuration loadConfigSafely() {
+        try {
+            return utils::getOrDefault();
+        } catch (const std::exception& err) {
+            LOG(Error) << "Failed to load lsfg-vk configuration: " << err.what()
+                       << "; loading the layer without frame generation";
+            return utils::Configuration{};
+        }
+    }
+}
+
+layer::Layer::Layer() : m_configuration(loadConfigSafely()) {
     auto result{utils::identifyProcess(this->m_configuration)};
     if (!result.has_value()) // If no profile exists, the layer will be unloaded
         return;
