#!/usr/bin/env sh
# mangoverlay -- loads the MangoHud fork (unified overlay) as a Vulkan layer
#
# Steam usage (Launch Options), per-game:
#   /home/Axforzi/Programas/overlay/mangoverlay %command%
#
# or stacked with other wrappers (e.g. goverlay bgmod):
#   /home/Axforzi/Programas/overlay/mangoverlay /home/Axforzi/.local/share/goverlay/gameconfig/Batman_\ Arkham\ Knight/bgmod %command%
#
# Mechanism: the layer lives in ~/.local/share/vulkan/implicit_layer.d/
#   MangoHud_overlay_unified.json  (VK_LAYER_MANGOHUD_overlay_unified_x86_64)
# and activates only when MANGOHUD_UNIFIED=1. It therefore does NOT shadow
# the system MangoHud: different name + its own per-game trigger.
#
# Note: it does not use VK_LAYER_PATH/VK_INSTANCE_LAYERS because Proton's
# container (pressure-vessel) does not propagate them; plain vars do.

# Enable OUR implicit layer (unique name)
export MANGOHUD_UNIFIED=1
# Kill the SYSTEM implicit layer (avoids double HUD) ONLY for this game
export DISABLE_MANGOHUD=1

# --- Per-game env vars (goverlay style) -----------------------------------
# Reads ~/.config/lsfg-vk/env.conf (INI: one section per game, e.g.
# [GenshinImpact.exe]; there is NO [global] section by design: env vars are
# ALWAYS per-game so a var that breaks one game never leaks into the others).
# The vars are exported BEFORE launching the game; if one breaks startup, set
# disable_all_vars=true in the game section and retry: the game launches
# without any vars.
#
# Game matching:
#   1. Explicit override: MANGOVERLAY_SECTION=<name> shell env var.
#   2. STEAM_COMPAT_APP_NAME set by Steam for Proton games (tried as-is and
#      with the .exe suffix when it does not match).
#   3. AUTHORITATIVE native resolution: Steam exports a numeric SteamAppId;
#      the matching appmanifest_<id>.acf maps it to the install dir and the
#      real executable (e.g. Haste.x86_64). Immune to the ever-growing
#      wrapper-shim chain (steam-launch-wrapper, reaper, SteamLaunch,
#      AppId=..., _v2-entry-point, --verb=...).
#   4. Fallback ONLY for non-Steam launches (AppImage, umu-run, ...): basename
#      of the command's first executable, skipping known wrapper shims.
#      The executable basename is tried as-is, with .exe appended, and with
#      .exe stripped (Proton games expose an .exe; native games usually do
#      not).
#   IMPORTANT: a pure wrapper command (e.g. just "steam-launch-wrapper")
#   NEVER becomes a section -- otherwise EVERY Steam game would share one
#   generic profile. Returning no section lets the lsfg-vk layer fall back to
#   its own executable matching, which picks the per-game profile.

ENV_CONF="${MANGOVERLAY_ENV_CONF:-$HOME/.config/lsfg-vk/env.conf}"

# --- mangoverlay uninstall ---------------------------------------------------
# Reverses install.sh from the installed copy itself. Self-locating: the
# install prefix is derived from THIS wrapper's real path (resolving the
# /usr/local/bin symlink and falling back to $HOME when run from a loose
# copy), so you never need to remember where it was installed.
#   mangoverlay uninstall              # ask, then remove
#   mangoverlay uninstall --yes        # non-interactive
#   mangoverlay uninstall --purge-configs  # ALSO remove ~/.config/lsfg-vk/
# --- Automatic OpenGL support (no manual flags needed) ---------------------
# The Vulkan-only layer never loads for games that create no Vulkan instance
# (e.g. LÖVE/OpenGL engines like Balatro), leaving them without the overlay.
# MangoHud ships a GL shim that intercepts GLX/EGL calls; we preload it
# unconditionally, exactly like the official `mangohud %command%` script. It
# is INERT for Vulkan games (the dlsym/GL hooks only fire when the game
# actually calls GL symbols) and the GL path self-disables under zink so the
# Vulkan layer stays authoritative -- no double HUD.
# Per-game escape hatch: set MANGOHUD_DLSYM=0 in the game's [section] in
# env.conf to disable GL hooking for that game only; it is exported after
# this block and wins.
# Self-locate the install prefix (same logic as `uninstall`) so the shim is
# found whether mangoverlay runs from $HOME/.local/bin or a --prefix install.
mangoverlay_prefix() {
   _real="$0"; _hops=0; _tgt=""
   while [ -L "$_real" ] && [ "$_hops" -lt 8 ]; do
      _tgt="$(readlink "$_real" 2>/dev/null)" || break
      case "$_tgt" in
         /*) _real="$_tgt" ;;
         *)  _real="$(dirname "$_real")/$_tgt" ;;
      esac
      _hops=$((_hops + 1))
   done
   case "$_real" in
      /*) : ;;
      *)  _real="$PWD/$_real" ;;
   esac
   case "$_real" in
      */.local/bin/mangoverlay)
         _cand="$(dirname "$(dirname "$(dirname "$_real")")")"
         # sanity: only trust a path that looks like a real install
         if [ -d "$_cand/.local/share/vulkan/implicit_layer.d" ] ||
            [ -d "$_cand/.local/lib/mangoverlay" ] ||
            [ -f "$_cand/.local/bin/mangoverlay" ]; then
            printf '%s\n' "$_cand"
            return
         fi
         ;;
   esac
   printf '%s\n' "$HOME"
}

# Removes the overlay layer, this wrapper, the lsfg-vk layer/tools/cache and
# the shell PATH block. Configs are kept unless --purge-configs. Never
# touches foreign files.
if [ "$1" = "uninstall" ]; then
   _yes=0; _purge=0
   shift
   for _a in "$@"; do
      case "$_a" in
         --yes) _yes=1 ;;
         --purge-configs) _purge=1 ;;
         -h|--help)
            echo "mangoverlay uninstall [--yes] [--purge-configs]"
            echo "Removes the overlay layer, this wrapper, lsfg-vk and the PATH block."
            echo "  --yes            non-interactive"
            echo "  --purge-configs  also remove ~/.config/lsfg-vk (profiles)"
            echo "Configs are kept unless --purge-configs."
            exit 0 ;;
         *) printf 'mangoverlay uninstall: unknown option %s\n' "$_a" >&2; exit 2 ;;
      esac
   done

   # --- self-locate the install prefix ---
   _real="$0"; _hops=0; _tgt=""
   while [ -L "$_real" ] && [ "$_hops" -lt 8 ]; do
      _tgt="$(readlink "$_real" 2>/dev/null)" || break
      case "$_tgt" in
         /*) _real="$_tgt" ;;
         *)  _real="$(dirname "$_real")/$_tgt" ;;
      esac
      _hops=$((_hops + 1))
   done
   case "$_real" in
      /*) : ;;
      *)  _real="$PWD/$_real" ;;
   esac
   _prefix="$HOME"
   case "$_real" in
      */.local/bin/mangoverlay)
         _cand="$(dirname "$(dirname "$(dirname "$_real")")")"
         # sanity: only trust a path that looks like a real install
         if [ -d "$_cand/.local/share/vulkan/implicit_layer.d" ] ||
            [ -d "$_cand/.local/lib/mangoverlay" ] ||
            [ -f "$_cand/.local/bin/mangoverlay" ]; then
            _prefix="$_cand"
         fi
         ;;
   esac

   _bin_dir="$_prefix/.local/bin"
   _lib_dir="$_prefix/.local/lib/mangoverlay"
   _lib_root="$_prefix/.local/lib"
   _lib64_root="$_prefix/.local/lib64"
   _vk_dir="$_prefix/.local/share/vulkan/implicit_layer.d"
   _vk_config="${XDG_CONFIG_HOME:-$HOME/.config}/vulkan/implicit_layer.d"
   _vk_layer_json="$_vk_dir/MangoHud_overlay_unified.json"
   _bin_mangoverlay="$_bin_dir/mangoverlay"
   _bin_lsfg_cli="$_bin_dir/lsfg-vk-cli"
   _cfg_dir="$HOME/.config/lsfg-vk"
   _lsfg_json="$_vk_config/VkLayer_LSFGVK_frame_generation.json"
   _lsfg_cache="${XDG_CACHE_HOME:-$HOME/.cache}/mangoverlay"
   _usr_bin_link="/usr/local/bin/mangoverlay"

   echo "Uninstall prefix: $_prefix/.local"
   echo "Configs: $_cfg_dir  (kept unless --purge-configs)"
   if [ "$_yes" -ne 1 ]; then
      printf 'Remove the overlay, mangoverlay wrapper and lsfg-vk layer? [y/N] '
      read _ans
      case "$_ans" in
         y|Y) : ;;
         *) printf 'aborted, nothing changed\n'; exit 1 ;;
      esac
      printf 'Confirm removing the installed files? (cannot be undone) [y/N] '
      read _ans
      case "$_ans" in
         y|Y) : ;;
         *) printf 'aborted, nothing changed\n'; exit 1 ;;
      esac
   fi

   # overlay layer + libs
   [ -f "$_vk_layer_json" ] && rm -f -- "$_vk_layer_json" && printf 'removed %s\n' "$_vk_layer_json"
   [ -f "$_vk_dir/MangoHud_overlay_unified_i386.json" ] && rm -f -- "$_vk_dir/MangoHud_overlay_unified_i386.json" && printf 'removed %s\n' "$_vk_dir/MangoHud_overlay_unified_i386.json"
   [ -f "$_vk_dir/MangoHud.json" ] && rm -f -- "$_vk_dir/MangoHud.json"
   [ -f "$_lib_dir/libMangoHud.so" ] && rm -f -- "$_lib_dir/libMangoHud.so"
   [ -f "$_lib_dir/libMangoHud_opengl.so" ] && rm -f -- "$_lib_dir/libMangoHud_opengl.so"
   [ -f "$_lib_dir/libMangoHud_shim.so" ] && rm -f -- "$_lib_dir/libMangoHud_shim.so"
   [ -f "$_lib_dir/lib32/libMangoHud.so" ] && rm -f -- "$_lib_dir/lib32/libMangoHud.so"
   [ -f "$_lib_dir/lib32/libMangoHud_opengl.so" ] && rm -f -- "$_lib_dir/lib32/libMangoHud_opengl.so"
   [ -f "$_lib_dir/lib32/libMangoHud_shim.so" ] && rm -f -- "$_lib_dir/lib32/libMangoHud_shim.so"
   rmdir "$_lib_dir/lib32" 2>/dev/null
   rmdir "$_lib_dir" 2>/dev/null && printf 'removed dir %s\n' "$_lib_dir" || true

   # this wrapper (the installed copy only)
   if [ "$_real" = "$_bin_mangoverlay" ] && [ -f "$_bin_mangoverlay" ]; then
      rm -f -- "$_bin_mangoverlay" && printf 'removed %s\n' "$_bin_mangoverlay"
   fi

   # the /usr/local/bin symlink, only when it points at OUR managed binary
   if [ -L "$_usr_bin_link" ]; then
      _link_target="$(readlink "$_usr_bin_link" 2>/dev/null || true)"
      if [ "$_link_target" = "$_bin_mangoverlay" ] ||
         { [ "$(basename "$_link_target" 2>/dev/null || true)" = "mangoverlay" ] &&
           [ "$(dirname "$_link_target" 2>/dev/null || true)" = "$_bin_dir" ]; }; then
         if [ -w "$(dirname "$_usr_bin_link")" ]; then
            rm -f -- "$_usr_bin_link" && printf 'removed %s\n' "$_usr_bin_link"
         else
            printf 'need root to remove %s\n' "$_usr_bin_link" >&2
            command -v sudo >/dev/null 2>&1 && sudo rm -f -- "$_usr_bin_link"
         fi
      else
         printf 'not removing %s: it does not point at the managed binary\n' "$_usr_bin_link" >&2
      fi
   fi

   # lsfg-vk
   [ -f "$_lsfg_json" ] && rm -f -- "$_lsfg_json" && printf 'removed %s\n' "$_lsfg_json"
   [ -f "$_bin_lsfg_cli" ] && rm -f -- "$_bin_lsfg_cli" && printf 'removed %s\n' "$_bin_lsfg_cli"
   [ -f "$_lib_root/liblsfg-vk-layer.so" ] && rm -f -- "$_lib_root/liblsfg-vk-layer.so"
   [ -f "$_lib_root/liblsfg-vk-layer.x86.so" ] && rm -f -- "$_lib_root/liblsfg-vk-layer.x86.so"
   [ -f "$_lib64_root/liblsfg-vk-layer.so" ] && rm -f -- "$_lib64_root/liblsfg-vk-layer.so"
   [ -f "$_vk_dir/VkLayer_LSFGVK_frame_generation.json" ] && rm -f -- "$_vk_dir/VkLayer_LSFGVK_frame_generation.json"
   rmdir "$_vk_dir" 2>/dev/null || true
   rmdir "$_vk_config" 2>/dev/null || true
   if [ -d "$_lsfg_cache" ]; then
      rm -rf -- "$_lsfg_cache" && printf 'removed cache %s\n' "$_lsfg_cache"
   fi

   # configs
   if [ "$_purge" -eq 1 ]; then
      [ -d "$_cfg_dir" ] && rm -rf -- "$_cfg_dir" && printf 'removed configs %s\n' "$_cfg_dir"
   else
      [ -d "$_cfg_dir" ] || [ -f "$_cfg_dir/conf.toml" ] || [ -f "$_cfg_dir/env.conf" ] \
         && printf 'kept configs: %s (pass --purge-configs to remove)\n' "$_cfg_dir"
   fi

   # shell PATH block
   for _rc in "$HOME/.zshrc" "$HOME/.bashrc"; do
      [ -f "$_rc" ] || continue
      if grep -q '^# >>> mangoverlay installer >>>' "$_rc" 2>/dev/null; then
         if [ -w "$_rc" ]; then
            _rc_tmp="$_rc.tmp.$$"
            sed '/^# >>> mangoverlay installer >>>/,/^# <<< mangoverlay installer <<</d' "$_rc" > "$_rc_tmp" && mv "$_rc_tmp" "$_rc"
            printf 'removed mangoverlay PATH block from %s\n' "$_rc"
         else
            printf 'cannot write %s; remove the mangoverlay PATH block manually\n' "$_rc" >&2
         fi
      fi
   done

   rmdir "$_bin_dir" 2>/dev/null || true
   rmdir "$_lib_root" 2>/dev/null || true
   rmdir "$_lib64_root" 2>/dev/null || true

   printf 'done: overlay, wrapper and lsfg-vk removed\n'
   exit 0
fi

# --- CLI-only commands -----------------------------------------------------
# Terminal-only commands; these NEVER launch a game and exit before the
# section-detection flow:
#   mangoverlay --list-profiles                      # show profiles in both files
#   mangoverlay --clean-profiles                     # ask, then remove ALL
#   mangoverlay --clean-profiles --yes               # remove ALL (non-interactive)
#   mangoverlay --clean-profiles <name> [<name>...]  # remove those from BOTH files
#   mangoverlay uninstall [--yes] [--purge-configs]  # remove the install itself
# A profile is the pair [SECTION] in env.conf + [[profile]] in conf.toml.
# Removing one name touches both files together; "ALL" removes every section
# and every profile, keeping conf.toml's version/[global]. The next launch of
# a game re-creates its own profile via the normal bootstrap, so a full clean
# is a safe reset.
# --------------------------------------------------------------------------
if [ "$1" = "--list-profiles" ] || [ "$1" = "--clean-profiles" ]; then
   _CONF_TOML="$(dirname -- "$ENV_CONF")/conf.toml"

   # prints every [[profile]] in conf.toml, one line per profile
   _toml_list() {
      awk '
         /^\[\[profile\]\]/ { flush(); state = 1; name = ""; active = ""; next }
         state == 1 && /^name[[:space:]]*=[[:space:]]*"/ {
            v = $0; sub(/^[^=]*=[[:space:]]*"/, "", v); sub(/"[[:space:]]*$/, "", v); name = v; next
         }
         state == 1 && /^active_in[[:space:]]*=[[:space:]]*"/ {
            v = $0; sub(/^[^=]*=[[:space:]]*"/, "", v); sub(/"[[:space:]]*$/, "", v); active = v; next
         }
         state == 1 && /^\[/ { flush(); state = 0 }
         { next }
         function flush() {
            if (name != "") {
               printf "  %s", name
               if (active != "" && active != name) printf "  (active_in: %s)", active
               printf "\n"
            }
            name = ""; active = ""
         }
         END { flush() }
      ' "$_CONF_TOML"
   }

   # prints env.conf without the [SECTION] named $1
   _env_hide_section() {
      awk -v target="$1" '
         /^\[/ { skip = ($0 == "[" target "]") }
         !skip { print }
      ' "$ENV_CONF"
   }

   # prints conf.toml without any profile whose name OR active_in is $1
   _toml_hide_profile() {
      awk -v target="$1" '
         function flush() {
            if (inblock && keep) printf "%s", buf
            inblock = 0; keep = 1; buf = ""
         }
         /^\[\[profile\]\]/ { flush(); inblock = 1; keep = 1; buf = $0 "\n"; next }
         inblock {
            if ($0 ~ /^\[/) { flush(); print $0; next }
            buf = buf $0 "\n"
            if ($0 ~ /^name[[:space:]]*=[[:space:]]*"/) {
               v = $0; sub(/^[^=]*=[[:space:]]*"/, "", v); sub(/"[[:space:]]*$/, "", v)
               if (v == target) keep = 0
            }
            if ($0 ~ /^active_in[[:space:]]*=[[:space:]]*"/) {
               v = $0; sub(/^[^=]*=[[:space:]]*"/, "", v); sub(/"[[:space:]]*$/, "", v)
               if (v == target) keep = 0
            }
            next
         }
         { print }
         END { flush() }
      ' "$_CONF_TOML"
   }

   # collapses runs of empty lines into a single one (INI cosmetics)
   _collapse_blanks() {
      awk 'NF { blank = 0; print; next } !blank { blank = 1; print "" }'
   }

   if [ "$1" = "--list-profiles" ]; then
      printf 'profiles in conf.toml:\n'
      _toml_list
      printf 'sections in env.conf:\n'
      awk '/^\[/ { sub(/^\[/, ""); sub(/\].*/, ""); printf "  %s\n", $0 }' "$ENV_CONF"
      exit 0
   fi

   # --clean-profiles: remaining args are names, or --yes, or nothing (= ALL)
   shift
   _yes=0
   for _a in "$@"; do
      [ "$_a" = "--yes" ] && _yes=1
   done

   if [ $# -eq 0 ] || { [ $# -eq 1 ] && [ "$1" = "--yes" ]; }; then
      # ALL mode: show what exists, then confirm on a terminal
      printf 'removing ALL profiles:\n'
      printf 'profiles in conf.toml:\n'
      _toml_list
      printf 'sections in env.conf:\n'
      awk '/^\[/ { sub(/^\[/, ""); sub(/\].*/, ""); printf "  %s\n", $0 }' "$ENV_CONF"
      if [ "$_yes" != "1" ]; then
         printf 'Remove all profiles? [y/N] '
         read _ans
         case "$_ans" in
            y|Y) : ;;
            *) printf 'aborted, nothing changed\n'; exit 1 ;;
         esac
      fi
      # env.conf -> keep nothing (config is sections-only by design)
      : > "$ENV_CONF"
      # conf.toml -> keep version + [global] block, drop every [[profile]]
      awk '
         /^\[\[profile\]\]/ { skip = 1; next }
         /^\[/ && !/^\[\[/ { skip = 0 }
         !skip { print }
      ' "$_CONF_TOML" > "$_CONF_TOML.tmp" && mv "$_CONF_TOML.tmp" "$_CONF_TOML"
      printf 'all profiles removed from %s and %s\n' "$ENV_CONF" "$_CONF_TOML"
      exit 0
   fi

   # named mode: remove each name from BOTH files together
   _removed=0
   for _name in "$@"; do
      [ "$_name" = "--yes" ] && continue
      _in_env=0; _in_toml=0
      _env_hide_section "$_name" > "$ENV_CONF.tmp"
      cmp -s "$ENV_CONF" "$ENV_CONF.tmp" || _in_env=1
      mv "$ENV_CONF.tmp" "$ENV_CONF"
      _toml_hide_profile "$_name" > "$_CONF_TOML.tmp"
      cmp -s "$_CONF_TOML" "$_CONF_TOML.tmp" || _in_toml=1
      mv "$_CONF_TOML.tmp" "$_CONF_TOML"
      if [ "$_in_env" = "1" ] || [ "$_in_toml" = "1" ]; then
         printf 'removed %s (env.conf%s, conf.toml%s)\n' \
            "$_name" \
            "$([ "$_in_env" = 1 ] && printf ' yes' || printf ' no')" \
            "$([ "$_in_toml" = 1 ] && printf ' yes' || printf ' no')"
         _removed=$((_removed + 1))
      else
         printf 'no profile named %s\n' "$_name"
      fi
   done
   # cosmetic: collapse repeated blank lines left in env.conf
   _collapse_blanks < "$ENV_CONF" > "$ENV_CONF.tmp" && mv "$ENV_CONF.tmp" "$ENV_CONF"
   [ "$_removed" -gt 0 ] && printf 'done, %d profile(s) removed from both files\n' "$_removed"
   exit 0
fi

# --- Automatic OpenGL activation -------------------------------------------
# Opens the GLX/EGL + dlsym shim so games that never create a Vulkan instance
# (LÖVE/OpenGL engines, wined3d fallbacks, ...) still get the unified overlay
# and menu. The shim is INERT for Vulkan games: no GL symbol call, no hooks,
# no double HUD (and under zink the GL path skips itself and defers to the
# Vulkan layer). Mirrors the official mangohud %command% behavior without any
# per-game flag. Per-game override stays available: MANGOHUD_DLSYM=0 in the
# game's env.conf section is exported AFTER this block and wins.
_shim_prefix="$(mangoverlay_prefix)"
_shim_dir="$_shim_prefix/.local/lib/mangoverlay"
_shim_so="$_shim_dir/libMangoHud_shim.so"
# Pick the 32-bit shim only when the *real* game binary is 32-bit (native ELF
# or PE32 .exe launched via Proton/wine). Unknown targets keep the default
# 64-bit shim: GL-native 32-bit games are rare, and a wrong-class PRELOAD is
# only a loader warning, never a crash.
if [ -f "$_shim_so" ] || [ -f "$_shim_dir/lib32/libMangoHud_shim.so" ]; then
   _is32=0
   for _a in "$@"; do
      case "$_a" in -*) continue ;; esac
      _c=$(basename -- "$_a" 2>/dev/null | tr '[:upper:]' '[:lower:]')
      case "$_c" in
         steam-launch-wrapper|steam-launcher|gamemoderun|game-performance|reaper|steamlaunch|appid=*|*entry-point*|--verb=*|umu-run|umu_run.py|--)
            continue ;;
      esac
      if [ -f "$_a" ]; then
         case "$(file -Lb -- "$_a" 2>/dev/null)" in
            *ELF\ 32-bit*|PE32\ executable*) _is32=1 ;;
            *ELF\ 64-bit*|PE32+\ executable*) _is32=0 ;;
         esac
         break
      fi
   done
   if [ "$_is32" = "1" ]; then
      if [ -f "$_shim_dir/lib32/libMangoHud_shim.so" ]; then
         _shim_so="$_shim_dir/lib32/libMangoHud_shim.so"
      else
         # 32-bit game but no 32-bit shim installed: never preload the
         # 64-bit shim into a 32-bit process (loader warning, no HUD).
         _shim_so=""
      fi
   fi
   if [ -f "$_shim_so" ]; then
      export MANGOHUD_DLSYM=1
      case ":${LD_PRELOAD-}:" in
         *":$_shim_so:"*) : ;;                   # already preloaded (stacked wrappers)
         *) export LD_PRELOAD="${LD_PRELOAD:+$LD_PRELOAD:}$_shim_so" ;;
      esac
   fi
fi

# Exports a "KEY=VALUE" pair; values with spaces or quotes are cleaned. The
# disable_all_vars flag is skipped (it is not an env var).
env_export_one() {
   _pair="$1"
   _key="${_pair%%=*}"
   _val="${_pair#*=}"
   # trim key and value ends BEFORE any check (inner value spaces are kept)
   _key=$(printf '%s' "$_key" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
   _val=$(printf '%s' "$_val" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
   [ -z "$_key" ] && return
   [ "$_key" = "disable_all_vars" ] && return
   # pre-wrapper flags (gamemoderun / game-performance): mangoverlay runs
   # them as wrappers, NEVER as exported env vars
   [ "$_key" = "gamemode" ] && return
   [ "$_key" = "game-performance" ] && return
   # strip surrounding quotes from the value
   case "$_val" in
      \"*\") _val=${_val#\"}; _val=${_val%\"} ;;
   esac
   # do not export empty keys
   [ -z "$_val" ] && return
   export "$_key=$_val"
}

env_section_lines() {
   _sec="$1"
   awk -v sec="$_sec" '
      BEGIN { in_sec = 0 }
      /^\[/ { in_sec = ($0 == "[" sec "]") }
      in_sec && /^[A-Za-z_][A-Za-z0-9_]*[[:space:]]*=/ { print }
   ' "$ENV_CONF"
}

# Resolves the game section from the Steam app manifest. This is the
# AUTHORITATIVE identity: Steam exports a numeric SteamAppId for every game it
# runs, and appmanifest_<id>.acf maps it to the install dir and the real
# executable. It is immune to the wrapper-shim chain Steam keeps growing
# (steam-launch-wrapper, reaper, SteamLaunch, AppId=..., _v2-entry-point,
# --verb=...). Returns the executable basename (e.g. Haste.x86_64) or nothing.
steam_appid_section() {
   _aid="${SteamAppId:-${STEAM_APPID:-}}"
   [ -n "$_aid" ] || return
   case "$_aid" in *[!0-9]*) return ;; esac # non-numeric is not a Steam appid

   # The manifest lives in steamapps/ next to every library root; the default
   # library plus any extra paths from libraryfolders.vdf.
   _manifest=""
   _default_manifest="$HOME/.local/share/Steam/steamapps/appmanifest_${_aid}.acf"
   if [ -f "$_default_manifest" ]; then
      _manifest="$_default_manifest"
   else
      for _lib in $(sed -n 's/.*"path"[[:space:]]*"\(.*\)".*/\1/p' \
         "$HOME/.local/share/Steam/steamapps/libraryfolders.vdf" 2>/dev/null); do
         [ -f "$_lib/steamapps/appmanifest_${_aid}.acf" ] || continue
         _manifest="$_lib/steamapps/appmanifest_${_aid}.acf"
         break
      done
   fi
   [ -n "$_manifest" ] || return

   _installdir=$(sed -n 's/.*"installdir"[[:space:]]*"\(.*\)".*/\1/p' "$_manifest" | head -1)
   [ -n "$_installdir" ] || return
   _game_dir="$(dirname -- "$_manifest")/common/$_installdir"
   [ -d "$_game_dir" ] || return

   # Prefer the conventional native binary names (Unity/Godot/whatever ships
   # <name>.x86_64 / .x86), then the real game executable. For Proton
   # (Windows) games the game is a .exe nested somewhere under the install
   # dir; data files wrongly marked +x (bm_installscript.vdf, *.vdf, ...)
   # never qualify.
   _cmd=""
   for _f in "$_game_dir/$_installdir.x86_64" "$_game_dir/$_installdir.x86" \
             "$_game_dir"/*.x86_64 "$_game_dir"/*.x86; do
      [ -f "$_f" ] && [ -x "$_f" ] && { _cmd=$(basename -- "$_f"); break; }
   done
   # Proton/Windows: the real game is an .exe somewhere in the tree. Skip
   # obvious installers/helpers; each distinct basename is a candidate and
   # the first one (sorted) wins -- for most games there is exactly one.
   if [ -z "$_cmd" ]; then
      _cmd=$(find "$_game_dir" -type f -iname '*.exe' \
         ! -iname '*unins*' ! -iname '*setup*' ! -iname '*install*' \
         ! -iname '*redist*' ! -iname '*launcher*' \
         -exec basename {} \; 2>/dev/null | sort -u | head -1)
   fi
   if [ -z "$_cmd" ]; then
      for _f in "$_game_dir"/*; do
         [ -f "$_f" ] && [ -x "$_f" ] || continue
         _b=$(basename -- "$_f")
         case "$_b" in
            *.so*|*_Data|*_data|version.txt|*.txt|gameoverlay*|lib*|*.sh|*.vdf|*.ini|*.cfg|*.json)
               continue ;;
         esac
         _cmd="$_b"
         break
      done
   fi
   [ -n "$_cmd" ] || return
   printf '%s\n' "$_cmd"
}

# Detects the section name to use (returns the .exe suffix when it matches
# the lsfg profile, or the name as-is).
detect_section() {
   # 1. explicit override
   if [ -n "${MANGOVERLAY_SECTION:-}" ]; then
      printf '%s\n' "$MANGOVERLAY_SECTION"
      return
   fi
   # 2. Steam Proton
   if [ -n "${STEAM_COMPAT_APP_NAME:-}" ]; then
      if grep -q "^\[${STEAM_COMPAT_APP_NAME}\]$" "$ENV_CONF" 2>/dev/null; then
         printf '%s\n' "${STEAM_COMPAT_APP_NAME}"
         return
      fi
      if grep -q "^\[${STEAM_COMPAT_APP_NAME}.exe\]$" "$ENV_CONF" 2>/dev/null; then
         printf '%s\n' "${STEAM_COMPAT_APP_NAME}.exe"
         return
      fi
   fi
   # 2b. numeric SteamAppId (same rule as lsfg-vk)
   if [ -n "${SteamAppId:-}" ] && grep -q "^\[${SteamAppId}\]$" "$ENV_CONF" 2>/dev/null; then
      printf '%s\n' "$SteamAppId"
      return
   fi
# 2c. AUTHORITATIVE: SteamAppId -> appmanifest -> installdir -> real binary.
    #     This replaces guessing through the ever-growing wrapper chain.
    _manifest_section="$(steam_appid_section)"
    if [ -n "$_manifest_section" ]; then
       printf '%s\n' "$_manifest_section"
       return
    fi
    # 2d. LAUNCHER-PROVIDED EXE: umu (the Proton-compatible runner bundled
    #     with Lutris/Heroic/manual launchers) treats $EXE as the source of
    #     truth for the real game binary. Honor it when it names a real
    #     binary (existing file or game-like extension); ignore shim values
    #     like winetricks or a bare wrapper name.
    if [ -n "${EXE:-}" ]; then
       _exe_base=$(basename -- "$EXE" 2>/dev/null | tr '[:upper:]' '[:lower:]')
       case "$_exe_base" in
          ''|winetricks|steam-launch-wrapper|steam-launcher|gamemoderun|game-performance|reaper|umu-run|umu_run.py|--)
             ;;
          *.exe|*.x86_64|*.x86|*.appimage)
             printf '%s\n' "$(basename -- "$EXE")"
             return
             ;;
          *)
             if [ -f "$EXE" ]; then
                printf '%s\n' "$(basename -- "$EXE")"
                return
             fi
             ;;
       esac
    fi
    # 3. basename of the first real executable in the argv, SKIPPING wrapper
    #    shims and option flags so the real game decides. Steam prepends
    #    steam-launch-wrapper/reaper/SteamLaunch/AppId=.../_v2-entry-point/
    #    --verb=... to Proton games; gamemoderun/game-performance can be
    #    stacked before the game; Lutris/Heroic prepend umu-run / umu_run.py
    #    plus their own options (e.g. `umu-run -p <prefix> -- <game>`) to run
    #    games through a bundled Proton-compatible runner. We prefer the first
    #    existing file, fall back to the first non-shim non-flag token (so a
    #    bare command like `vkcube` still works), and never mint a generic
    #    section from wrapper-only command lines.
    _real_cmd=""
    _fallback_cmd=""
    while [ "$#" -gt 0 ]; do
       _candidate=$(basename -- "$1" 2>/dev/null | tr '[:upper:]' '[:lower:]')
       case "$_candidate" in
          steam-launch-wrapper|steam-launcher|gamemoderun|game-performance|reaper|steamlaunch|appid=*|*entry-point*|--verb=*|umu-run|umu_run.py|--)
             shift
             continue
             ;;
       esac
       case "$1" in
          -*) shift; continue ;;
       esac
       [ -z "$_fallback_cmd" ] && _fallback_cmd="$1"
       if [ -f "$1" ]; then
          _real_cmd="$1"
          break
       fi
       case "$_candidate" in
          *.exe|*.x86_64|*.x86|*.appimage)
             _real_cmd="$1"
             break
             ;;
       esac
       shift
    done
    [ -z "$_real_cmd" ] && _real_cmd="$_fallback_cmd"
    if [ -z "${_real_cmd:-}" ]; then
       # only wrapper shims/flags were present; do NOT mint a generic section
       return
    fi
    _cmd=$(basename -- "$_real_cmd" 2>/dev/null)
    [ -z "$_cmd" ] && return
    # a wrapper-only command must never become a section (see header note)
    case "$_cmd" in
       [sS][tT][eE][aA][mM][lL][aA][uU][nN][cC][hH]|appid=*|*entry-point*|--verb=*|steam-launch-wrapper|steam-launcher|gamemoderun|game-performance|reaper|umu-run|umu_run.py|--)
          return
          ;;
    esac
   if grep -q "^\[${_cmd}\]$" "$ENV_CONF" 2>/dev/null; then
      printf '%s\n' "$_cmd"
      return
   fi
   _with_exe="${_cmd}.exe"
   if [ "$_with_exe" != "$_cmd" ] && grep -q "^\[${_with_exe}\]$" "$ENV_CONF" 2>/dev/null; then
      printf '%s\n' "$_with_exe"
      return
   fi
   _noexe=${_cmd%.exe}
   if [ "$_noexe" != "$_cmd" ] && grep -q "^\[${_noexe}\]$" "$ENV_CONF" 2>/dev/null; then
      printf '%s\n' "$_noexe"
      return
   fi
   # 3c. AppImage normalization: lowercase, strip .AppImage/.appimage and a
   # trailing version like -v0.2.1, so e.g. Eden-Linux-v0.2.1.AppImage matches
   # the [eden] section. Applies only when a section with the normalized name
   # exists; otherwise falls back to the literal basename (unchanged behavior).
   _norm=$(printf '%s' "$_cmd" | sed -E 's/\.(AppImage|appimage)$//; s/-v?[0-9]+\.[0-9]+(\.[0-9]+)?$//' | tr '[:upper:]' '[:lower:]')
   if [ -n "$_norm" ] && [ "$_norm" != "$_cmd" ] && grep -q "^\[${_norm}\]$" "$ENV_CONF" 2>/dev/null; then
      printf '%s\n' "$_norm"
      return
   fi
   printf '%s\n' "$_cmd"
}

if [ -f "$ENV_CONF" ]; then
   SECTION="$(detect_section "$@")"
   if [ -n "$SECTION" ]; then
      # Bootstrap (universal): if the game has no [SECTION] in env.conf yet,
      # declare it automatically so the game gets a profile WITHOUT manual
      # per-game config. Two files keep their own scope:
      #   env.conf -> a [SECTION] exporting LSFGVK_PROFILE="<name>" (the
      #               per-game activation the layer reads by name).
      #   conf.toml -> a [[profile]] with name/active_in = <SECTION> and sane
      #               defaults (multiplier 1 = frame gen OFF, vsync pacing)
      #               IF that profile does not exist yet. Unknown games start
      #               WITHOUT frame generation; enable it from the menu.
      # This preserves isolation: every game still gets its OWN section (there
      # is no [global]); only the declaration step is automated.
      _CONF_TOML="$(dirname -- "$ENV_CONF")/conf.toml"
      if ! grep -q "^\[${SECTION}\]$" "$ENV_CONF" 2>/dev/null; then
         {
            printf '\n[%s]\n' "$SECTION"
            printf 'LSFGVK_PROFILE="%s"\n' "$SECTION"
         } >> "$ENV_CONF"
      fi
      if [ -f "$_CONF_TOML" ] && \
         ! grep -q '^active_in[[:space:]]*=[[:space:]]*"'"${SECTION}"'"$' "$_CONF_TOML" 2>/dev/null; then
         {
            printf '\n[[profile]]\n'
            printf 'active_in = "%s"\n' "$SECTION"
            printf 'flow_scale = 1.0\n'
            printf 'frame_limit = 0\n'
            printf 'multiplier = 1\n'
            printf 'name = "%s"\n' "$SECTION"
            printf 'override_present_mode = false\n'
            printf 'pacing_mode = "vsync"\n'
            printf 'performance_mode = false\n'
            printf 'preserve_swapchain_image_count = false\n'
         } >> "$_CONF_TOML"
      fi
      # if the game section has disable_all_vars, export nothing from it
      _sec_off="$(env_section_lines "$SECTION" | awk -F= '/^disable_all_vars[[:space:]]*=[[:space:]]*[Tt]rue/ { print "1"; exit }')"
      if [ "$_sec_off" != "1" ]; then
         IFS_SAVE=$IFS
         IFS='
'
         for _line in $(env_section_lines "$SECTION"); do
            [ -n "$_line" ] && env_export_one "$_line"
         done
         IFS=$IFS_SAVE

         # goverlay tweaks that are NOT env vars: flags wrapping the command.
         # gamemode -> gamemoderun; game-performance (cachyos). Used only when
         # the binary exists; silently ignored otherwise.
         _has_gamemode="$(env_section_lines "$SECTION" | \
            awk -F= '/^gamemode[[:space:]]*=[[:space:]]*1$/ { print "1"; exit }')"
         _has_gameperf="$(awk -v sec="$SECTION" '
            BEGIN { in_sec = 0 }
            /^\[/ { in_sec = ($0 == "[" sec "]") }
            in_sec && /^game-performance[[:space:]]*=[[:space:]]*1$/ { print "1"; exit }
         ' "$ENV_CONF")"
         [ "$_has_gamemode" = "1" ] && command -v gamemoderun >/dev/null 2>&1 && EXEC_WRAPPER=gamemoderun
         if [ "$_has_gameperf" = "1" ] && command -v game-performance >/dev/null 2>&1; then
            EXEC_WRAPPER=game-performance
         fi
      fi
   fi
fi

if [ -n "${EXEC_WRAPPER:-}" ] && command -v "$EXEC_WRAPPER" >/dev/null 2>&1; then
   exec "$EXEC_WRAPPER" "$@"
fi

exec "$@"